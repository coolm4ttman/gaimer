{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder GaimerSandbox/Assets": {
                    "watch": "@GEMROOT:GaimerSandbox@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder GaimerSandbox/Registry": {
                    "watch": "@GEMROOT:GaimerSandbox@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
